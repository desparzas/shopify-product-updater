# Shopify
ACCESS_TOKEN=your_shopify_access_token
SHOP=your-shop-name
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SCOPES=write_products,read_products
SHOPIFY_API_VERSION=2026-01
USE_GRAPHQL=false

# App
PORT=3000
WEBHOOK_SECRET=your_webhook_secret
WEBHOOK_SECRET_ORDER_CREATE=your_webhook_secret
WEBHOOK_SECRET_PRODUCT_UPDATE=your_webhook_secret
SKIP_WEBHOOK_HMAC=false
SKIP_SSL_VERIFY=false

# MongoDB
MONGODB_URI=mongodb://user:password@host:27017/dbname
